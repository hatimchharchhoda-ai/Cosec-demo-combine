            <ComponentRef Id="cmpIISConfig" />
        </Feature>
        <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." Schedule="afterInstallValidate" />
        <Media Id="1" Cabinet="cab1.cab" />
        <Media Id="2" Cabinet="cab2.cab" />
        <Property Id="DB_SERVER" Value="localhost\SQLEXPRESS" Secure="yes" />
        <Property Id="DB_NAME" Value="matgen" Secure="yes" />
        <Property Id="DB_USER" Value="sa" Secure="yes" />
        <Property Id="ALLUSERS" Value="1" />
        <Property Id="JWT_SECRET" Value="REPLACE_WITH_MIN_32_CHAR_SECRET_KEY" Secure="yes" />
        <Property Id="MATPOLL_JWT_KEY1" Value="matpoll-auth" Secure="yes" />
        <Property Id="MATPOLL_JWT_KEY2" Value="device-polling-2026" Secure="yes" />
        <Property Id="GENETEC_SERVER" Value="192.168.27.115" Secure="yes" />
        <Property Id="GENETEC_PORT" Value="4590" Secure="yes" />
        <Property Id="GENETEC_USER" Value="Admin" Secure="yes" />
        <Property Id="DB_PASSWORD" Secure="yes" />
        <Property Id="GENETEC_APPID" Secure="yes" />
        <Property Id="GENETEC_PASSWORD" Secure="yes" />
        <Property Id="MY_LICENSE_ACCEPTED" Secure="yes" />
        <Property Id="WIX_DOWNGRADE_DETECTED" Secure="yes" />
        <Property Id="WIX_UPGRADE_DETECTED" Secure="yes" />
        <Property Id="CommitIIS7ConfigTransaction" Hidden="yes" />
        <Property Id="CommitMetabaseTransaction" Hidden="yes" />
        <Property Id="ConfigureIIs7Exec" Hidden="yes" />
        <Property Id="ConfigureIIsExec" Hidden="yes" />
        <Property Id="RollbackIIS7ConfigTransaction" Hidden="yes" />
        <Property Id="RollbackMetabaseTransaction" Hidden="yes" />
        <Property Id="StartIIS7ConfigTransaction" Hidden="yes" />
        <Property Id="StartMetabaseTransaction" Hidden="yes" />
        <Property Id="WriteIIS7ConfigChanges" Hidden="yes" />
        <Property Id="WriteMetabaseChanges" Hidden="yes" />
        <Property Id="IISINSTALLED">
            <RegistrySearch Id="CheckIIS" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\W3SVC" Name="Start" Type="raw" Win64="yes" />
        </Property>
        <UI>
            <Dialog Id="DatabaseSettingsDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] – Database Settings">
                <Control Id="DbServerEdit" Type="Edit" X="130" Y="70" Width="210" Height="18" Property="DB_SERVER" TabSkip="no" />
                <Control Id="DbNameEdit" Type="Edit" X="130" Y="100" Width="210" Height="18" Property="DB_NAME" TabSkip="no" />
                <Control Id="DbUserEdit" Type="Edit" X="130" Y="130" Width="210" Height="18" Property="DB_USER" TabSkip="no" />
                <Control Id="DbPasswordEdit" Type="Edit" X="130" Y="160" Width="210" Height="18" Property="DB_PASSWORD" TabSkip="no" Password="yes" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="MyLicenseDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="240" Y="243" Width="56" Height="17" Text="Next" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="InstallDirDlg">DB_SERVER AND DB_NAME AND DB_USER AND DB_PASSWORD</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="300" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="yes" Disabled="yes" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="228" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="DlgTitle" Type="Text" X="15" Y="6" Width="300" Height="15" Text="{\WixUI_Font_Title}Database Configuration" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DlgDesc" Type="Text" X="25" Y="23" Width="280" Height="15" Text="Enter the database connection details below." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DbServerLabel" Type="Text" X="25" Y="73" Width="100" Height="17" Text="Server\Instance:" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DbNameLabel" Type="Text" X="25" Y="103" Width="100" Height="17" Text="Database Name:" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DbUserLabel" Type="Text" X="25" Y="133" Width="100" Height="17" Text="Username:" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DbPasswordLabel" Type="Text" X="25" Y="163" Width="100" Height="17" Text="Password:" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="DbServerError" Type="Text" X="130" Y="88" Width="210" Height="12" Text="{\WixUI_Font_Normal}*Server name is required." TabSkip="yes" Hidden="yes" NoPrefix="yes">
                    <Condition Action="show">NOT DB_SERVER</Condition>
                    <Condition Action="hide">DB_SERVER</Condition>
                </Control>
                <Control Id="DbNameError" Type="Text" X="130" Y="118" Width="210" Height="12" Text="{\WixUI_Font_Normal}*Database name is required." TabSkip="yes" Hidden="yes" NoPrefix="yes">
                    <Condition Action="show">NOT DB_NAME</Condition>
                    <Condition Action="hide">DB_NAME</Condition>
                </Control>
                <Control Id="DbUserError" Type="Text" X="130" Y="148" Width="210" Height="12" Text="{\WixUI_Font_Normal}*Username is required." TabSkip="yes" Hidden="yes" NoPrefix="yes">
                    <Condition Action="show">NOT DB_USER</Condition>
                    <Condition Action="hide">DB_USER</Condition>
                </Control>
                <Control Id="DbPasswordError" Type="Text" X="130" Y="178" Width="210" Height="12" Text="{\WixUI_Font_Normal}*Password is required." TabSkip="yes" Hidden="yes" NoPrefix="yes">
                    <Condition Action="show">NOT DB_PASSWORD</Condition>
                    <Condition Action="hide">DB_PASSWORD</Condition>
                </Control>
            </Dialog>
            <Dialog Id="MyLicenseDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] – License Agreement">
                <Control Id="AcceptCheckBox" Type="CheckBox" X="20" Y="190" Width="330" Height="18" Property="MY_LICENSE_ACCEPTED" Text="I accept the terms of this license agreement" CheckBoxValue="1" TabSkip="no" />
                <Control Id="Back" Type="PushButton" X="180" Y="230" Width="56" Height="17" Text="Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="240" Y="230" Width="56" Height="17" Text="Next" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="DatabaseSettingsDlg">MY_LICENSE_ACCEPTED = "1"</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="300" Y="230" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Text="{\WixUI_Font_Title}MATRIX INTEGRATOR License Agreement" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="LicenseText" Type="ScrollableText" X="20" Y="60" Width="330" Height="140" Text="MyLicenseRtf" TabSkip="yes" Sunken="yes" />
            </Dialog>
        </UI>
        <UIRef Id="WixUI_InstallDir" />
        <InstallExecuteSequence>
            <Custom Action="SetWriteAppSettingsData" After="InstallInitialize">NOT REMOVE</Custom>
            <Custom Action="SetWriteMatPollAppSettingsData" After="SetWriteAppSettingsData">NOT REMOVE</Custom>
            <Custom Action="SetRemoveAppSettingsData" Before="RemoveAppSettings">REMOVE~="ALL"</Custom>
            <Custom Action="RemoveAppSettings" Before="SetRemoveMatPollAppSettingsData">REMOVE~="ALL"</Custom>
            <Custom Action="SetRemoveMatPollAppSettingsData" Before="RemoveMatPollAppSettings">REMOVE~="ALL"</Custom>
            <Custom Action="RemoveMatPollAppSettings" Before="RemoveFiles">REMOVE~="ALL"</Custom>
            <Custom Action="WriteAppSettings" After="InstallFiles">NOT REMOVE</Custom>
            <Custom Action="WriteMatPollAppSettings" After="WriteAppSettings">NOT REMOVE</Custom>
        </InstallExecuteSequence>
    </Product>
</Wix>