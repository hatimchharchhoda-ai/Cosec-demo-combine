<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>

    <Binary Id="CustomActBinary"
            SourceFile="$(var.CustomActionsDir)\CustomActions.CA.dll" />

    <Property Id="JWT_SECRET"         Value="REPLACE_WITH_MIN_32_CHAR_SECRET_KEY" Secure="yes" />
    <Property Id="MATPOLL_JWT_KEY1"   Value="matpoll-auth" Secure="yes" />
    <Property Id="MATPOLL_JWT_KEY2"   Value="device-polling-2026" Secure="yes" />
    <Property Id="GENETEC_SERVER"     Value="192.168.27.115" Secure="yes" />
    <Property Id="GENETEC_PORT"       Value="4590" Secure="yes" />
    <Property Id="GENETEC_USER"       Value="Admin" Secure="yes" />
    <Property Id="GENETEC_PASSWORD"   Secure="yes" />
    <Property Id="GENETEC_APPID"      Secure="yes" />

    <CustomAction Id="SetInstallUrlRewriteData"
              Property="InstallUrlRewrite"
              Value="[COSECFOLDER]rewrite_amd64_en-US.msi" />
              
    <!-- Deferred: reads path from CustomActionData, no session.Database needed -->
    <CustomAction Id="InstallUrlRewrite"
            BinaryKey="CustomActBinary"
            DllEntry="InstallUrlRewrite"
            Execute="deferred"
            Impersonate="no"
            Return="check" />

    <CustomAction Id="SetWriteAppSettingsData"
                  Property="WriteAppSettings"
                  Value="COSECFOLDER=[COSECFOLDER];DB_SERVER=[DB_SERVER];DB_NAME=[DB_NAME];DB_USER=[DB_USER];DB_PASSWORD=[DB_PASSWORD];JWT_SECRET=[JWT_SECRET];MATPOLL_JWT_KEY1=[MATPOLL_JWT_KEY1];MATPOLL_JWT_KEY2=[MATPOLL_JWT_KEY2];GENETEC_SERVER=[GENETEC_SERVER];GENETEC_PORT=[GENETEC_PORT];GENETEC_USER=[GENETEC_USER];GENETEC_PASSWORD=[GENETEC_PASSWORD];GENETEC_APPID=[GENETEC_APPID]" />

    <CustomAction Id="WriteAppSettings"
                  BinaryKey="CustomActBinary"
                  DllEntry="WriteAppSettings"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <!-- UNINSTALL custom actions -->

    <!-- 1. Stop IIS site + app pool FIRST (before any files touched) -->
    <CustomAction Id="RemoveIISSiteAndPool"
              BinaryKey="CustomActBinary"
              DllEntry="RemoveIISSiteAndPool"
              Execute="deferred"
              Return="ignore"
              Impersonate="no" />

    <!-- 2. Stop and delete the backend Windows service -->
    <CustomAction Id="StopAndRemoveService"
                  BinaryKey="CustomActBinary"
                  DllEntry="StopAndRemoveService"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- 3. Setter for backend folder cleanup -->
    <CustomAction Id="SetCleanupFolderData"
                  Property="CleanupInstallFolder"
                  Value="COSECFOLDER=[COSECFOLDER]" />

    <!-- 4. Deletes everything in COSECFOLDER except appsettings.json -->
    <CustomAction Id="CleanupInstallFolder"
                  BinaryKey="CustomActBinary"
                  DllEntry="CleanupInstallFolder"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- 5. Setter for web folder cleanup -->
    <CustomAction Id="SetCleanupWebFolderData"
                  Property="CleanupWebFolder"
                  Value="COSECWEBFOLDER=[COSECWEBFOLDER]" />

    <!-- 6. Force-deletes MATINTWeb folder entirely -->
    <CustomAction Id="CleanupWebFolder"
                  BinaryKey="CustomActBinary"
                  DllEntry="CleanupWebFolder"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <InstallExecuteSequence>

      <Custom Action="SetInstallUrlRewriteData"
              Before="InstallUrlRewrite">NOT Installed AND NOT URLREWRITE_INSTALLED</Custom>

      <Custom Action="InstallUrlRewrite"
              After="InstallFiles">NOT Installed AND NOT URLREWRITE_INSTALLED</Custom>

      <Custom Action="SetWriteAppSettingsData"
         After="InstallInitialize">NOT REMOVE</Custom>

      <Custom Action="WriteAppSettings"
               After="InstallFiles">NOT REMOVE</Custom>

      <!-- UNINSTALL SEQUENCE -->

      <!-- 1. Stop IIS site + delete site + delete app pool -->
      <Custom Action="RemoveIISSiteAndPool"
              Before="StopAndRemoveService">REMOVE~="ALL"</Custom>

      <!-- 2. Stop and remove the backend service -->
      <Custom Action="StopAndRemoveService"
              Before="RemoveFiles">REMOVE~="ALL"</Custom>

      <!-- 3. Set data props for both cleanup CAs -->
      <Custom Action="SetCleanupFolderData"
              After="StopAndRemoveService">REMOVE~="ALL"</Custom>

      <Custom Action="SetCleanupWebFolderData"
              After="SetCleanupFolderData">REMOVE~="ALL"</Custom>

      <!-- 4. After WiX removes tracked files, force-clean both folders -->
      <Custom Action="CleanupInstallFolder"
              After="RemoveFiles">REMOVE~="ALL"</Custom>

      <Custom Action="CleanupWebFolder"
              After="CleanupInstallFolder">REMOVE~="ALL"</Custom>

    </InstallExecuteSequence>

  </Fragment>
</Wix>