<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Fragment>

    <UI>
      <UIRef Id="WixUI_Common" />

      <Dialog Id="MyLicenseDlg"
              Width="370" Height="270"
              Title="[ProductName] – License Agreement">

        <Control Id="Title" Type="Text"
                 X="15" Y="10" Width="340" Height="20"
                 Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}MATRIX INTEGRATOR License Agreement</Text>
        </Control>

        <Control Id="LicenseText" Type="ScrollableText"
                X="20" Y="60" Width="330" Height="140"
                Sunken="yes" TabSkip="yes">
          <Text SourceFile="Assets\License.rtf" />
        </Control>

        <Control Id="AcceptCheckBox" Type="CheckBox"
                 X="20" Y="190" Width="330" Height="18"
                 Property="MY_LICENSE_ACCEPTED"
                 CheckBoxValue="1"
                 Text="I accept the terms of this license agreement"/>

        <Control Id="Back" Type="PushButton"
                 X="180" Y="230" Width="56" Height="17"
                 Text="Back">
          <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
        </Control>

        <Control Id="Next" Type="PushButton"
                 X="240" Y="230" Width="56" Height="17"
                 Default="yes"
                 Text="Next">
          <Publish Event="NewDialog" Value="DatabaseSettingsDlg">
            MY_LICENSE_ACCEPTED = "1"
          </Publish>
        </Control>

        <Control Id="Cancel" Type="PushButton"
                 X="300" Y="230" Width="56" Height="17"
                 Cancel="yes"
                 Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>

      </Dialog>

    </UI>

    <Property Id="MY_LICENSE_ACCEPTED" Secure="yes" />

  </Fragment>
</Wix>