<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CustomActions</AssemblyName>
    <RootNamespace>CustomActions</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Deployment.WindowsInstaller">
      <HintPath>C:\Program Files (x86)\WiX Toolset v3.14\SDK\Microsoft.Deployment.WindowsInstaller.dll</HintPath>
    </Reference>

    <Reference Include="Microsoft.Web.Administration">
      <HintPath>C:\Windows\System32\inetsrv\Microsoft.Web.Administration.dll</HintPath>
    </Reference>
    
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConfigCrypto\ConfigCrypto.Installer.csproj" />
    <None Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="MakeSfxCA" AfterTargets="Build">
    <PropertyGroup>
      <WixSdkDir>C:\Program Files (x86)\WiX Toolset v3.14\SDK\</WixSdkDir>
      <OutDir>$(MSBuildProjectDirectory)\bin\x64\$(Configuration)\net472\</OutDir>
      <SfxOutput>$(OutDir)CustomActions.CA.dll</SfxOutput>
      <SfxInput>$(OutDir)CustomActions.dll</SfxInput>
      <ConfigCryptoDll>$(OutDir)ConfigCrypto.dll</ConfigCryptoDll>
      <WixInstallerDll>$(WixSdkDir)Microsoft.Deployment.WindowsInstaller.dll</WixInstallerDll>
      <!-- CORRECT PATH: x64 subfolder -->
      <SfxDll>$(WixSdkDir)x64\sfxca.dll</SfxDll>
    </PropertyGroup>

    <ItemGroup>
      <CAFilesToCopy Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.config" />
    </ItemGroup>
    <Copy SourceFiles="@(CAFilesToCopy)" DestinationFolder="$(OutDir)" />

    <Error Condition="!Exists('$(SfxInput)')"
           Text="CustomActions.dll not found at: $(SfxInput)" />
    <Error Condition="!Exists('$(ConfigCryptoDll)')"
           Text="ConfigCrypto.dll not found at: $(ConfigCryptoDll)" />
    <Error Condition="!Exists('$(SfxDll)')"
           Text="SfxCA.dll not found at: $(SfxDll)" />
    <Error Condition="!Exists('$(WixInstallerDll)')"
           Text="Microsoft.Deployment.WindowsInstaller.dll not found at: $(WixInstallerDll)" />
    <Error Condition="!Exists('$(OutDir)CustomAction.config')"
           Text="CustomAction.config not found at: $(OutDir)CustomAction.config" />

    <Exec Command="&quot;$(WixSdkDir)MakeSfxCA.exe&quot; &quot;$(SfxOutput)&quot; &quot;$(SfxDll)&quot; &quot;$(SfxInput)&quot; &quot;$(WixInstallerDll)&quot; &quot;$(ConfigCryptoDll)&quot; &quot;$(OutDir)CustomAction.config&quot; &quot;C:\Windows\System32\inetsrv\Microsoft.Web.Administration.dll&quot;"
          ConsoleToMSBuild="true" />
  </Target>

</Project>