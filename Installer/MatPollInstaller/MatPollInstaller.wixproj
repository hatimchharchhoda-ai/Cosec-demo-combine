<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform       Condition=" '$(Platform)'       == '' ">x86</Platform>
    <ProductVersion>3.10</ProductVersion>
    <ProjectGuid>{35B04D6F-7960-43DD-9139-ED60C2C85F2B}</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>MatInt</OutputName>
    <OutputType>Package</OutputType>
    <DefineSolutionProperties>false</DefineSolutionProperties>

    <!--
      Point this at the folder that contains CustomActions.CA.dll
      (the MakeSfxCA-wrapped managed CA assembly).
    -->
    <CustomActionsDir Condition=" '$(CustomActionsDir)' == '' ">$(MSBuildThisFileDirectory)CustomActions\bin\x64\$(Configuration)\net472</CustomActionsDir>
  </PropertyGroup>

  <!-- ================================================================== -->
  <!-- Debug configuration                                                  -->
  <!-- ================================================================== -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <SuppressValidation>true</SuppressValidation>
    <DefineConstants>
      Debug;
      COSECSourceDir=SourceFiles\COSEC;
      COSECWebSourceDir=SourceFiles\COSECWeb;
      CustomActionsDir=$(CustomActionsDir)
    </DefineConstants>
  </PropertyGroup>

  <!-- ================================================================== -->
  <!-- Release configuration                                                -->
  <!-- ================================================================== -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <SuppressValidation>true</SuppressValidation>
    <DefineConstants>
      COSECSourceDir=SourceFiles\COSEC;
      COSECWebSourceDir=SourceFiles\COSECWeb;
      CustomActionsDir=$(CustomActionsDir)
    </DefineConstants>
  </PropertyGroup>

  <!-- ================================================================== -->
  <!-- Source files                                                         -->
  <!-- ================================================================== -->
  <ItemGroup>
    <!-- Core installer pages -->
    <Compile Include="Product.wxs" />
    <Compile Include="MyLicenseDlg.wxs" />
    <Compile Include="CustomActionsRef.wxs" />

    <!-- File component groups (unchanged from original) -->
    <Compile Include="COSECService.wxs" />
    <Compile Include="COSECServiceDlls.wxs" />
    <Compile Include="COSECWebFiles.wxs" />
    <Compile Include="IISSetup.wxs" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- WiX extensions                                                       -->
  <!-- ================================================================== -->
  <ItemGroup>
    <WixExtension Include="WixUtilExtension" />
    <WixExtension Include="WixUIExtension" />
    <WixExtension Include="WixIIsExtension" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- Build the managed CA project first                                   -->
  <!-- ================================================================== -->
  <ItemGroup>
    <ProjectReference Include="CustomActions\CustomActions.csproj">
      <Name>CustomActions</Name>
      <Project>{74734530-67EE-4F9B-8B1D-B514F12F9AB6}</Project>
      <Private>true</Private>
      <DoNotHarvest>true</DoNotHarvest>
    </ProjectReference>
  </ItemGroup>


  <!-- Import WiX targets -->
  <Import Project="$(WixTargetsPath)"
          Condition=" '$(WixTargetsPath)' != '' " />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets"
          Condition=" '$(WixTargetsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets') " />

</Project>