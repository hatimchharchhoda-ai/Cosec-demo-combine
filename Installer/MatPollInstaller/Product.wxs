<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*"
			 Name="MatPoll System"
			 Language="1033"
			 Version="1.0.0.0"
			 Manufacturer="MatPollInstaller"
			 UpgradeCode="A395DCB3-A767-4FAB-A65C-94FF30DAF379">
		<Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
		<MediaTemplate />
		
		<!-- Allows upgrading/reinstalling cleanly -->
		<MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

		<!-- Install folder UI dialog support -->
		<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
		<UIRef Id="WixUI_Minimal" />

		<Condition Message="IIS must be installed. Enable it from Windows Features first.">
			<![CDATA[Installed OR IISINSTALLED]]>
		</Condition>
		
		<Feature Id="MainFeature" Title="MatPoll" Level="1">
			<ComponentGroupRef Id="MatPollFiles" />
			<ComponentGroupRef Id="COSECServiceFiles" />
			<ComponentGroupRef Id="COSECServiceDlls" />
			<ComponentGroupRef Id="COSECWebFiles" />
			<ComponentGroupRef Id="IISComponents" />
		</Feature>

		<!-- Fixed: Must start with TARGETDIR as root -->
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFiles64Folder">
				<Directory Id="INSTALLFOLDER" Name="MatPoll" />
				<Directory Id="COSECFOLDER" Name="COSEC" />
				<Directory Id="COSECWEBFOLDER" Name="COSECWeb" />
			</Directory>
		</Directory>

	</Product>
</Wix>