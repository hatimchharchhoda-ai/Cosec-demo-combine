<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Matrix Integrator"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="MatInt"
           UpgradeCode="A395DCB3-A767-4FAB-A65C-94FF30DAF379">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />

    <MediaTemplate />
    <MajorUpgrade
      DowngradeErrorMessage="A newer version is already installed."
      Schedule="afterInstallExecute"
      AllowSameVersionUpgrades="no" />

    <Property Id="WIXUI_INSTALLDIR" Value="COSECFOLDER" />

    <Property Id="URLREWRITE_INSTALLED">
      <RegistrySearch Id="CheckUrlRewrite"
                      Type="raw"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\IIS Extensions\URL Rewrite"
                      Name="Version" />
    </Property>

    <UIRef Id="WixUI_InstallDir" />

    <UI>
      <DialogRef Id="MyLicenseDlg" />

      <Publish Dialog="WelcomeDlg"
               Control="Next"
               Event="NewDialog"
               Value="MyLicenseDlg"
               Order="2">1</Publish>

      <!-- Back from InstallDir -> License -->
      <Publish Dialog="InstallDirDlg"
               Control="Back"
               Event="NewDialog"
               Value="MyLicenseDlg"
               Order="1">1</Publish>

      <!-- Custom progress messages -->
      <ProgressText Action="InstallInitialize">Preparing MATINT installation...</ProgressText>
      <ProgressText Action="InstallFinalize">Finalizing MATINT installation...</ProgressText>
      <ProgressText Action="InstallFiles">Copying MATINT application files...</ProgressText>
      <ProgressText Action="RemoveFiles">Removing MATINT application files...</ProgressText>
      <ProgressText Action="RemoveExistingProducts">Removing previous version of Matrix Integrator...</ProgressText>
      <ProgressText Action="InstallServices">Registering MATINT API Service...</ProgressText>
      <ProgressText Action="StartServices">Starting MATINT API Service...</ProgressText>
      <ProgressText Action="StopServices">Stopping MATINT API Service...</ProgressText>
      <ProgressText Action="DeleteServices">Unregistering MATINT API Service...</ProgressText>
      <ProgressText Action="WriteRegistryValues">Writing configuration to registry...</ProgressText>
      <ProgressText Action="RemoveRegistryValues">Removing registry configuration...</ProgressText>
      <ProgressText Action="CreateFolders">Creating required directories...</ProgressText>
      <ProgressText Action="RemoveFolders">Cleaning up directories...</ProgressText>
      <ProgressText Action="WriteIniValues">Writing application settings...</ProgressText>
      <ProgressText Action="SelfRegModules">Registering application components...</ProgressText>
      <ProgressText Action="CreateShortcuts">Creating shortcuts...</ProgressText>
      <ProgressText Action="RollbackCleanup">Rolling back changes...</ProgressText>
      <ProgressText Action="InstallUrlRewrite">Installing IIS URL Rewrite Module...</ProgressText>
      <ProgressText Action="WriteMetabaseValues">Setting up IIS application pool and website...</ProgressText>
      <ProgressText Action="WriteAppSettings">Configuring appsettings.json...</ProgressText>
    </UI>

    <Feature Id="MainFeature" Title="Matrix Integrator" Level="1">
      <ComponentGroupRef Id="COSECServiceFiles" />
      <ComponentGroupRef Id="COSECServiceDlls" />
      <ComponentGroupRef Id="COSECWebFiles" />
      <ComponentGroupRef Id="IISComponents" />
      <ComponentRef Id="UrlRewriteRedist" />
    </Feature>

    <CustomActionRef Id="WriteAppSettings" />

    <!-- Read actual IIS wwwroot path from registry -->
    <Property Id="WWWROOT_DIR">
      <RegistrySearch Id="IISWwwRoot"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\InetStp"
                      Name="PathWWWRoot"
                      Type="raw" />
    </Property>

    <SetDirectory Id="COSECWEBFOLDER"
                  Value="[WWWROOT_DIR]\MATINTWeb">
      WWWROOT_DIR
    </SetDirectory>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="MATRIXFOLDER" Name="Matrix">
          <Directory Id="COSECFOLDER" Name="MATINT Matgen Service" >
            <Component Id="UrlRewriteRedist"
                      Guid="C1D2E3F4-A5B6-7890-ABCD-EF1234567890"
                      Win64="yes">
              <File Id="UrlRewriteMsiFile"
                    Source="redist\rewrite_amd64_en-US.msi"
                    KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <Directory Id="COSECWEBFOLDER" Name="MATINTWeb" />
    </Directory>

  </Product>
</Wix>